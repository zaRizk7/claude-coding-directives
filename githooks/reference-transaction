#!/bin/sh
# Git calls this hook before committing a local ref transaction.
# Mark worker worktrees with coding.worker=true in their worktree-local Git config.
[ "$1" = prepared ] || exit 0
worker=$(git config --bool --get coding.worker)
status=$?
case "$status:$worker" in
  1:|0:false) exit 0 ;;
  0:true) ;;
  *) echo 'reference-transaction: invalid coding.worker configuration' >&2; exit 1 ;;
esac

protected=$(git config --get coding.protectedBranch)
if [ -z "$protected" ]; then
  protected=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
  protected=${protected#origin/}
fi
if [ -z "$protected" ]; then
  for branch in main master; do
    if git show-ref --verify --quiet "refs/heads/$branch"; then protected=$branch; break; fi
  done
fi
[ -n "$protected" ] || protected=$(git worktree list --porcelain | awk '/^branch refs\/heads\// { sub(/^branch refs\/heads\//, ""); print; exit } /^$/ { exit }')
[ -n "$protected" ] || protected=$(git config --get init.defaultBranch || printf '%s' main)
git check-ref-format "refs/heads/$protected" || { echo 'reference-transaction: invalid protected branch' >&2; exit 1; }
while read -r old new ref; do
  if [ "$ref" = "refs/heads/$protected" ]; then
    echo "reference-transaction: workers must not move refs/heads/$protected" >&2
    exit 1
  fi
done
exit 0
